# ==========================================
# Trading Copilot - .gitignore
# ==========================================

# --------------------
# Environment / Secrets
# --------------------
.env
.env.*
!.env.example

# --------------------
# Python
# --------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
*.egg
*.egg-info/
dist/
build/
.eggs/

# Testing / Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --------------------
# FastAPI / Application
# --------------------
*.log
logs/

# Local SQLite state (conversation history)
*.db
*.sqlite
*.sqlite3

# --------------------
# Node.js
# --------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
.next/
out/

# Environment files
frontend/.env
frontend/.env.*
!frontend/.env.example

# --------------------
# IDE / Editors
# --------------------
.vscode/
.idea/
*.swp
*.swo

# --------------------
# OS
# --------------------
.DS_Store
Thumbs.db

# --------------------
# Jupyter
# --------------------
.ipynb_checkpoints/

# --------------------
# Temporary files
# --------------------
*.tmp
*.temp
*.bak